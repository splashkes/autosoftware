{
  "schemaVersion": 1,
  "program": "live-anonymous-red-team",
  "defaultRunWindow": {
    "timezone": "America/Toronto",
    "startHour": 1,
    "endHour": 5
  },
  "safetyGuards": {
    "discoveryMaxRequestsPerHost": 50,
    "adversarialMaxRequestsPerScenario": 300,
    "maxConcurrency": 10,
    "maxStreamConnections": 3,
    "maxLaunchScenariosInFlight": 1,
    "successfulLaunchCooldownMinutes": 10
  },
  "owners": {
    "boot-surface": {
      "subsystem": "Boot surface and public shell",
      "repoPaths": [
        "kernel/cmd/webd/main.go",
        "kernel/cmd/webd/bootloader.go"
      ]
    },
    "public-api-surface": {
      "subsystem": "Public contracts and registry APIs",
      "repoPaths": [
        "kernel/internal/http/json/contracts.go",
        "kernel/internal/http/json/registry.go",
        "kernel/cmd/apid/main.go"
      ]
    },
    "csrf-browser-writes": {
      "subsystem": "Same-origin write enforcement",
      "repoPaths": [
        "kernel/internal/http/server/security.go",
        "kernel/internal/http/server/request_context.go"
      ]
    },
    "feedback-loop-public-post": {
      "subsystem": "Public incident ingest path",
      "repoPaths": [
        "kernel/internal/http/json/feedback_loop.go",
        "kernel/internal/feedback_loop/reporter.go",
        "kernel/cmd/webd/main.go"
      ]
    },
    "boot-execution-public": {
      "subsystem": "Anonymous launch and preview routing",
      "repoPaths": [
        "kernel/internal/http/json/execution.go",
        "kernel/cmd/webd/bootloader.go",
        "kernel/cmd/webd/main.go"
      ]
    },
    "mounted-routing-rewrite": {
      "subsystem": "Mounted route rewriting and proxying",
      "repoPaths": [
        "kernel/cmd/webd/main.go"
      ]
    },
    "registry-permalinks": {
      "subsystem": "Registry permalink and share-hash routing",
      "repoPaths": [
        "kernel/cmd/webd/main.go",
        "kernel/internal/runtime/registry_hash_index.go"
      ]
    },
    "rate-limits": {
      "subsystem": "Anonymous rate limiting",
      "repoPaths": [
        "kernel/internal/http/server/rate_limit.go",
        "kernel/cmd/webd/main.go",
        "kernel/cmd/apid/main.go"
      ]
    },
    "growth-surface": {
      "subsystem": "Public growth and partial rendering",
      "repoPaths": [
        "kernel/internal/http/json/growth.go",
        "kernel/internal/realizations/growth.go",
        "kernel/cmd/webd/main.go"
      ]
    },
    "remote-registry-dependency": {
      "subsystem": "Remote registry dependency handling",
      "repoPaths": [
        "kernel/internal/materializer/service.go",
        "kernel/cmd/webd/main.go"
      ]
    }
  },
  "scenarios": [
    {
      "id": "wave1-homepage-baseline",
      "wave": 1,
      "driver": "http",
      "host": "autosoftware.app",
      "class": "surface-mapping",
      "ownerKey": "boot-surface",
      "requestTemplate": {
        "method": "GET",
        "url": "https://autosoftware.app/",
        "headers": {
          "accept": "text/html",
          "cache-control": "no-cache"
        },
        "requestCount": 1
      },
      "preconditions": [
        "Run during the default low-traffic window unless explicitly overridden."
      ],
      "maxRequests": 5,
      "maxConcurrency": 1,
      "abortCondition": "Abort after 2 consecutive unexpected 5xx responses or any broad availability loss on the main host.",
      "expectedStatuses": [
        200
      ],
      "expectedSafeBehavior": [
        "Homepage stays reachable.",
        "Security headers are present and non-empty.",
        "CSP nonce changes between repeated baseline runs."
      ],
      "evidenceRequirements": [
        "status line",
        "response headers",
        "x-as-request-id",
        "cf-ray",
        "response hash"
      ]
    },
    {
